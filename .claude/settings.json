{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx gltfjsx *)",
      "Bash(npx @gltf-transform/cli *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vite *)",
      "Bash(npx prettier --write *)",
      "Bash(npx eslint *)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo '$TOOL_INPUT' | node -e \"const i=require('fs').readFileSync('/dev/stdin','utf8');try{const p=JSON.parse(i).file_path||'';if(p.match(/\\.(ts|tsx|js|jsx)$/)){process.exit(0)}else{process.exit(1)}}catch{process.exit(1)}\" && npx prettier --write \"$(echo '$TOOL_INPUT' | node -e \"const i=require('fs').readFileSync('/dev/stdin','utf8');console.log(JSON.parse(i).file_path)\")\""
          }
        ]
      }
    ]
  }
}
